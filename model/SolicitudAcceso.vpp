-- ============================================================
-- SolicitudAcceso.vpp
-- Etapa E2: Registro de solicitud de acceso e invariante de riesgo
-- Proyecto: Sistema de Control de Acceso Zero Trust con VDM++
-- Depende de: Tipos.vpp (E1)
-- ============================================================
class SolicitudAcceso

types

  public SolicitudAcceso ::
    id                : Tipos`SolicitudId
    usuario           : Tipos`UsuarioId
    recurso           : Tipos`RecursoId
    dispositivo       : Tipos`DispositivoId
    dispositivoValido : bool
    riesgo            : nat
    mfaVerificado     : bool
    estado            : Tipos`EstadoAcceso
  inv s == s.riesgo <= 100;

end SolicitudAcceso