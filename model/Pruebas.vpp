class Pruebas is subclass of Tipos

instance variables
  motor : MotorZeroTrust := new MotorZeroTrust();

operations

  private Verifica : bool ==> ()
  Verifica(cond) == skip
  pre cond;

  public run : () ==> ()
  run() ==
  (
    dcl u1 : UsuarioId := mk_token(1);
    dcl u2 : UsuarioId := mk_token(2);
    dcl r1 : RecursoId := mk_token(10);
    dcl r2 : RecursoId := mk_token(20);
    dcl d1 : DispositivoId := mk_token(50);
    dcl usr1 : Usuario := new Usuario(u1, <USUARIO>, true);
    dcl usr2 : Usuario := new Usuario(u2, <USUARIO>, true);
    dcl rec1 : Recurso := new Recurso(r1, "Servidor", false);
    dcl rec2 : Recurso := new Recurso(r2, "BaseDatos", true);

    usr1.AsignarPermiso(r1);
    usr1.AsignarPermiso(r2);

    motor.RegistrarUsuario(usr1);
    motor.RegistrarUsuario(usr2);
    motor.RegistrarRecurso(rec1);
    motor.RegistrarRecurso(rec2);

    for all rid in set usr1.GetPermisos() do
      motor.ConcederPermiso(usr1.GetId(), rid);

    Verifica(usr1.GetRol() = <USUARIO>);
    Verifica(rec1.GetNombre() = "Servidor");
    Verifica(
      motor.EvaluarAcceso(
        mk_SolicitudAcceso`SolicitudAcceso(
          mk_token(100), u1, r1, d1, true, 20, false, <PENDIENTE>))
      = <AUTORIZADO>);

    Verifica(
      motor.EvaluarAcceso(
        mk_SolicitudAcceso`SolicitudAcceso(
          mk_token(101), u2, r1, d1, true, 10, false, <PENDIENTE>))
      = <DENEGADO>);

    Verifica(
      motor.EvaluarAcceso(
        mk_SolicitudAcceso`SolicitudAcceso(
          mk_token(102), u1, r1, d1, true, 85, false, <PENDIENTE>))
      = <DENEGADO>);

    Verifica(
      motor.EvaluarAcceso(
        mk_SolicitudAcceso`SolicitudAcceso(
          mk_token(103), u1, r2, d1, true, 10, false, <PENDIENTE>))
      = <DENEGADO>);

    Verifica(
      motor.EvaluarAcceso(
        mk_SolicitudAcceso`SolicitudAcceso(
          mk_token(104), u1, r2, d1, true, 10, true, <PENDIENTE>))
      = <AUTORIZADO>);
    Verifica(motor.RevocarAcceso(mk_token(104)) = true);
    Verifica(motor.RevocarAcceso(mk_token(104)) = false);

    return
  );

  public caso5 : () ==> SolicitudAcceso`SolicitudAcceso
  caso5() ==
    return mk_SolicitudAcceso`SolicitudAcceso(
             mk_token(900), mk_token(1), mk_token(10), mk_token(50),
             true, 120, true, <PENDIENTE>);

  -- Cada grupo usa su propio motor para poder repetirlo en cualquier orden.
  private MotorDePrueba : () ==> MotorZeroTrust
  MotorDePrueba() ==
  (
    dcl m : MotorZeroTrust := new MotorZeroTrust();
    dcl activo : UsuarioId := mk_token(1);
    dcl inactivo : UsuarioId := mk_token(2);
    dcl recurso : RecursoId := mk_token(10);
    m.RegistrarUsuario(new Usuario(activo, <USUARIO>, true));
    m.RegistrarUsuario(new Usuario(inactivo, <USUARIO>, false));
    m.RegistrarRecurso(new Recurso(recurso, "Servidor", false));
    m.ConcederPermiso(activo, recurso);
    m.ConcederPermiso(inactivo, recurso);
    return m
  );

  private SolicitudBase : () ==> SolicitudAcceso`SolicitudAcceso
  SolicitudBase() ==
    return mk_SolicitudAcceso`SolicitudAcceso(
      mk_token(200), mk_token(1), mk_token(10), mk_token(50),
      true, 79, false, <PENDIENTE>);

  public decisionesE8 : () ==> seq of EstadoAcceso
  decisionesE8() ==
  (
    dcl m : MotorZeroTrust := MotorDePrueba();
    dcl base : SolicitudAcceso`SolicitudAcceso := SolicitudBase();
    dcl resultados : seq of EstadoAcceso := [];
    -- Mismo usuario, recurso y dispositivo para los dos lados del umbral.
    for sol in [
      base,
      mu(base, id |-> mk_token(201), riesgo |-> 80),
      mu(base, id |-> mk_token(202), dispositivoValido |-> false),
      mu(base, id |-> mk_token(203), usuario |-> mk_token(2)),
      mu(base, id |-> mk_token(204), usuario |-> mk_token(99)),
      mu(base, id |-> mk_token(205), recurso |-> mk_token(99))
    ] do
      resultados := resultados ^ [m.EvaluarAcceso(sol)];
    Verifica(resultados = [<AUTORIZADO>, <DENEGADO>, <DENEGADO>,
                            <DENEGADO>, <DENEGADO>, <DENEGADO>]);
    return resultados
  );

  -- Ejecutar por separado. Cada operacion provoca una precondicion concreta.
  public idRepetido : () ==> EstadoAcceso
  idRepetido() ==
  (
    dcl m : MotorZeroTrust := MotorDePrueba();
    dcl sol : SolicitudAcceso`SolicitudAcceso := SolicitudBase();
    Verifica(m.EvaluarAcceso(sol) = <AUTORIZADO>);
    return m.EvaluarAcceso(sol)
  );

  public usuarioDuplicado : () ==> ()
  usuarioDuplicado() ==
  (
    dcl m : MotorZeroTrust := MotorDePrueba();
    m.RegistrarUsuario(new Usuario(mk_token(1), <USUARIO>, true))
  );

  public recursoDuplicado : () ==> ()
  recursoDuplicado() ==
  (
    dcl m : MotorZeroTrust := MotorDePrueba();
    m.RegistrarRecurso(new Recurso(mk_token(10), "Otro", false))
  );

  public permisoSinUsuario : () ==> ()
  permisoSinUsuario() ==
  (
    dcl m : MotorZeroTrust := MotorDePrueba();
    m.ConcederPermiso(mk_token(99), mk_token(10))
  );

  public permisoSinRecurso : () ==> ()
  permisoSinRecurso() ==
  (
    dcl m : MotorZeroTrust := MotorDePrueba();
    m.ConcederPermiso(mk_token(1), mk_token(99))
  );

end Pruebas
