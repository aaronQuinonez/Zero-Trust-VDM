class Usuario is subclass of Tipos
-- Etapa E3: Uso de Set para permisos asociados al usuario
-- Etapa E4: Definición de atributos y operaciones de la clase Usuario

instance variables
  id : UsuarioId;
  rol : Rol;
  activo : bool;
  permisos : set of RecursoId := {};

operations
  public Usuario : UsuarioId * Rol * bool ==> Usuario
  Usuario(uid, r, a) ==
  (
    id := uid;
    rol := r;
    activo := a
  );

  public GetId : () ==> UsuarioId
  GetId() == return id;

  public GetRol : () ==> Rol
  GetRol() == return rol;

  public EsActivo : () ==> bool
  EsActivo() == return activo;

  public GetPermisos : () ==> set of RecursoId
  GetPermisos() == return permisos;

  public AsignarPermiso : RecursoId ==> ()
  AsignarPermiso(rid) ==
    permisos := permisos union {rid};

end Usuario