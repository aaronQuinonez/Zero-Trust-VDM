class Tipos
-- Etapa E1: Identificacion de tipos Quote y Token del modelo Zero Trust

types
  -- 4.1 Tipos Quote: listas cerradas de valores conocidos por el modelo
  public EstadoAcceso =
    <PENDIENTE> |
    <EVALUANDO> |
    <AUTORIZADO> |
    <DENEGADO> |
    <REVOCADO>;

  public NivelRiesgo =
    <BAJO> |
    <MEDIO> |
    <ALTO> |
    <CRITICO>;

  public Rol =
    <USUARIO> |
    <ADMINISTRADOR> |
    <AUDITOR>;

  -- 4.2 Tipos Token: identificadores abstractos unicos
  public UsuarioId     = token;
  public RecursoId     = token;
  public DispositivoId = token;
  public SolicitudId   = token;

end Tipos
